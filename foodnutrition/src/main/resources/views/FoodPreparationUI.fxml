<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rahulshankar.dialysisapp.controllers.FoodPreparationController"
            prefWidth="1000" prefHeight="700">
    <top>
        <VBox spacing="5" style="-fx-background-color: #17324D;">
            <padding><Insets top="20" right="24" bottom="18" left="24"/></padding>
            <Label text="Renal Food Nutrition Calculator"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Estimate potassium, phosphorus and sodium from the ingredients and weights entered."
                   style="-fx-font-size: 13px; -fx-text-fill: #E5EDF5;"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="14">
            <padding><Insets top="20" right="24" bottom="14" left="24"/></padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Dish name:"/>
                <TextField fx:id="dishNameField" promptText="e.g. Vegetable curry" HBox.hgrow="ALWAYS"/>
                <Button text="Manage Food Catalogue" onAction="#handleManageFoods"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Ingredient:"/>
                <ComboBox fx:id="ingredientComboBox" promptText="Select food" prefWidth="220"/>
                <Label text="Weight (g):"/>
                <TextField fx:id="weightField" promptText="Grams" prefWidth="110"/>
                <Button text="Add Ingredient" onAction="#handleAddIngredient"/>
            </HBox>
            <TableView fx:id="ingredientTableView" VBox.vgrow="ALWAYS" prefHeight="360">
                <columns>
                    <TableColumn fx:id="ingredientColumn" text="Ingredient" prefWidth="220"/>
                    <TableColumn fx:id="weightColumn" text="Weight (g)" prefWidth="110"/>
                    <TableColumn fx:id="potassiumColumn" text="Potassium (mg)" prefWidth="150"/>
                    <TableColumn fx:id="phosphorusColumn" text="Phosphorus (mg)" prefWidth="150"/>
                    <TableColumn fx:id="sodiumColumn" text="Sodium (mg)" prefWidth="140"/>
                </columns>
                <placeholder><Label text="Add ingredients to calculate the dish nutrition."/></placeholder>
            </TableView>
            <VBox spacing="8" style="-fx-background-color: #F1F5F9; -fx-background-radius: 8;">
                <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
                <Label text="Calculated totals" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <GridPane hgap="24" vgap="8">
                    <Label text="Potassium:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label fx:id="totalPotassiumLabel" text="0.00" style="-fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="mg" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <Label text="Phosphorus:" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                    <Label fx:id="totalPhosphorusLabel" text="0.00" style="-fx-font-weight: bold;" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
                    <Label text="mg" GridPane.columnIndex="5" GridPane.rowIndex="0"/>
                    <Label text="Sodium:" GridPane.columnIndex="6" GridPane.rowIndex="0"/>
                    <Label fx:id="totalSodiumLabel" text="0.00" style="-fx-font-weight: bold;" GridPane.columnIndex="7" GridPane.rowIndex="0"/>
                    <Label text="mg" GridPane.columnIndex="8" GridPane.rowIndex="0"/>
                </GridPane>
            </VBox>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Remove Selected Ingredient" onAction="#handleDeleteIngredient"/>
                <Button text="Clear Dish" onAction="#handleClearDish"/>
                <Button text="Calculate Summary" defaultButton="true" onAction="#handleSubmit"
                        style="-fx-background-color: #176B55; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
            <Label text="Important: Results depend on the accuracy of the food data entered. Unknown values are shown as incomplete, not zero. Confirm dietary targets and food data with your renal dietitian."
                   wrapText="true" style="-fx-font-size: 11px; -fx-text-fill: #555555;"/>
        </VBox>
    </center>
</BorderPane>